# Email Configuration
# ===================
# Supports multiple email providers via adapters

# Email Provider Selection
# ------------------------
# Choose your email provider: 'mailchannels', 'mailgun', 'gmail', or 'smtp'
# Default: mailchannels
# If EMAIL_API_KEY is not set, automatically falls back to SMTP
EMAIL_PROVIDER=mailchannels

# Email API Key
# -------------
# Your email provider API key (required for mailchannels and mailgun)
# Leave empty to use SMTP fallback
EMAIL_API_KEY=

# Recipient Configuration
# -----------------------
# Email address where contact form submissions will be sent
CONTACT_EMAIL_TO=contact@yourcompany.com

# MailChannels Configuration
# ==========================
# Documentation: https://docs.mailchannels.net/
# Get your API key from: https://console.mailchannels.com/
# Set EMAIL_PROVIDER=mailchannels and EMAIL_API_KEY to use

# Mailgun Configuration
# =====================
# Documentation: https://documentation.mailgun.com/
# Mailgun supports both API and SMTP - provide either or both

# Your Mailgun domain (required if using EMAIL_API_KEY)
MAILGUN_DOMAIN=mg.yourdomain.com

# Mailgun region: 'us' or 'eu' (default: us)
MAILGUN_REGION=us

# Mailgun API Method (Alternative)
# Get your API key from: https://app.mailgun.com/app/account/security/api_keys
# Set EMAIL_PROVIDER=mailgun and EMAIL_API_KEY to use API
# If both API and SMTP credentials are provided, API is preferred

# Mailgun SMTP Method (Recommended)
# Use standard SMTP_ variables above with Mailgun credentials:
# SMTP_HOST is auto-detected based on MAILGUN_REGION (smtp.mailgun.org or smtp.eu.mailgun.org)
# SMTP_USER=postmaster@mg.yourdomain.com
# SMTP_PASSWORD=your-mailgun-smtp-password
# If only SMTP credentials are provided (no EMAIL_API_KEY), Mailgun will use SMTP

# SMTP Configuration
# ==================
# Standard SMTP credentials used by:
# - SMTP provider (EMAIL_PROVIDER=smtp)
# - Mailgun (when EMAIL_API_KEY is not set)
# - Any future SMTP-capable providers
# Works with Gmail, Outlook, SendGrid, Mailgun, and other SMTP providers

# SMTP server host (auto-detected for Mailgun based on MAILGUN_REGION)
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP authentication credentials
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# For Gmail: Generate an app password at https://myaccount.google.com/apppasswords
# For Outlook: Use your regular password or app password if 2FA is enabled
# For SendGrid: Use 'apikey' as username and your API key as password

# Alternative SMTP providers configuration examples:
# ==================================================

# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_START_TLS=true
# MAIL_APP_USER=apikey
# MAIL_APP_PASSWORD=your-sendgrid-api-key

# For Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_START_TLS=true
# MAIL_APP_USER=your-mailgun-username
# MAIL_APP_PASSWORD=your-mailgun-password

# For AWS SES:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_START_TLS=true
# MAIL_APP_USER=your-aws-access-key-id
# MAIL_APP_PASSWORD=your-aws-secret-access-key

# For Outlook/Office365:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_START_TLS=true
# MAIL_APP_USER=your-outlook@example.com
# MAIL_APP_PASSWORD=your-outlook-password
