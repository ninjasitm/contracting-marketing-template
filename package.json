{
  "name": "@nitm/contracting-marketing-template",
  "version": "2.0.12",
  "description": "a Nuxt marketing template and boilerplate with a lot of useful features",
  "author": "ninjasitm",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git://github.com/ninjasitm/contracting-marketing-template/git"
  },
  "scripts": {
    "build": "pnpm --filter @nitm/web build",
    "dev": "turbo run dev --filter=@nitm/web",
    "dev:all": "turbo run dev",
    "generate": "pnpm --filter @nitm/web generate",
    "preview": "pnpm --filter @nitm/web build && pnpm --filter @nitm/web preview",
    "prepare": "pnpm --filter @nitm/web prepare",
    "postinstall": "pnpm prepare",
    "lint": "eslint --ext \".ts,.js,.vue\" .",
    "lint:fix": "eslint --fix --ext \".ts,.js,.vue\" .",
    "typecheck": "pnpm --filter @nitm/web typecheck && pnpm --filter @nitm/web exec vue-tsc --noEmit -p ../../tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "release": "release-it"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@nuxt/config": "^2.18.1",
    "@nuxt/test-utils": "^3.19.0",
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "consola": "^3.4.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-es-x": "^8.6.2",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-vue": "^10.1.0",
    "happy-dom": "^20.5.3",
    "jsdom": "^26.1.0",
    "release-it": "^16.3.0",
    "serve": "^14.2.4",
    "turbo": "2.11.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10",
    "webpack": "^5.99.9"
  },
  "release-it": {
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "git": {
      "commitMessage": "chore(release): release v${version}"
    }
  },
  "packageManager": "pnpm@8.5.1+sha1.97019f5a8ec2416123506419ab36dd558e4c72eb"
}
