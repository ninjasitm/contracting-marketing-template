{
  "extends": "./apps/web/.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "jsx": "preserve",
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "sourceMap": true
  },
  "include": [
    "apps/web/.nuxt/nuxt.d.ts",
    "apps/web/.nuxt/types/**/*.d.ts",
    "apps/web/.nuxt/imports.d.ts",
    "apps/web/.nuxt/components.d.ts",
    "apps/web/types/**/*.d.ts",
    "test/**/*.ts",
    "test/**/*.d.ts",
    "vitest.config.ts"
  ]
}
